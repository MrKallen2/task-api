<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram id="p1" name="1 Context"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1380" pageHeight="640"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tp1" value="C4 Level 1 — Context: Task Service" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="36" as="geometry"/></mxCell><mxCell id="p1_u" value="&lt;b&gt;Пользователь&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Человек]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Создаёт и ведёт список задач через веб- или мобильный клиент, Postman или curl&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="270" height="170" as="geometry"/></mxCell><mxCell id="p1_s" value="&lt;b&gt;Task Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Программная система]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Сервис управления задачами: создание, просмотр, изменение, удаление, поиск и напоминания о сроках&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="220" width="300" height="190" as="geometry"/></mxCell><mxCell id="p1_m" value="&lt;b&gt;Email-сервис&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Внешняя система]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Рассылает пользователям напоминания о сроках задач&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8a8a8a;fontColor=#ffffff;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1050" y="230" width="270" height="170" as="geometry"/></mxCell><mxCell id="ep10" value="Управляет задачами [HTTPS, REST/JSON]" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_u" target="p1_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ep11" value="Отправляет напоминания [SMTP]" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_s" target="p1_m"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2 Container"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1660" pageHeight="880"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tp2" value="C4 Level 2 — Container: Task Service" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="36" as="geometry"/></mxCell><mxCell id="bp20" value="Task Service — Docker Compose, сеть app_net" style="rounded=1;dashed=1;fillColor=none;strokeColor=#888888;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="850" height="740" as="geometry"/></mxCell><mxCell id="p2_c" value="&lt;b&gt;Клиент&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Веб/мобильный клиент, Postman, curl]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Отправляет REST-запросы пользователя&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="360" width="240" height="170" as="geometry"/></mxCell><mxCell id="p2_g" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Nginx]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Единая точка входа: проксирует /tasks в API, порты сервисов закрыты&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B57;fontColor=#ffffff;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="360" width="250" height="170" as="geometry"/></mxCell><mxCell id="p2_a" value="&lt;b&gt;Task API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Java 17, Spring Boot 3.2]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;REST CRUD задач, бизнес-логика, кэширование, напоминания&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="930" y="360" width="280" height="170" as="geometry"/></mxCell><mxCell id="p2_r" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Кэш]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Хранит кэш списка задач, снижает нагрузку на базу данных&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0562B;fontColor=#ffffff;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="930" y="150" width="280" height="140" as="geometry"/></mxCell><mxCell id="p2_d" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[PostgreSQL 16, volume db_data]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Основное хранилище: таблица tasks&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#2F6FA8;fontColor=#ffffff;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="930" y="640" width="280" height="160" as="geometry"/></mxCell><mxCell id="p2_m" value="&lt;b&gt;Email-сервис&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Внешняя система]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Отправка напоминаний&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8a8a8a;fontColor=#ffffff;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1370" y="380" width="260" height="130" as="geometry"/></mxCell><mxCell id="ep20" value="HTTP-запросы [HTTPS]" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_c" target="p2_g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ep21" value="Проксирует запросы [HTTP :8080]" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_g" target="p2_a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ep22" value="Читает и пишет кэш [RESP :6379]" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_a" target="p2_r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ep23" value="Читает и пишет задачи [JDBC :5432]" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_a" target="p2_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ep24" value="Напоминания [SMTP]" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_a" target="p2_m"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3 Component"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="1040"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tp3" value="C4 Level 3 — Component: Task API" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="36" as="geometry"/></mxCell><mxCell id="bp30" value="Task API — Java 17, Spring Boot 3.2" style="rounded=1;dashed=1;fillColor=none;strokeColor=#888888;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="860" height="700" as="geometry"/></mxCell><mxCell id="p3_g" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Nginx]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Проксирует HTTP-запросы&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B57;fontColor=#ffffff;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="115" width="230" height="140" as="geometry"/></mxCell><mxCell id="p3_tc" value="&lt;b&gt;TaskController&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[@RestController /tasks]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Принимает GET, POST, PUT, DELETE и возвращает JSON&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7D7F5;fontColor=#0f1b2d;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="130" width="320" height="110" as="geometry"/></mxCell><mxCell id="p3_ts" value="&lt;b&gt;TaskService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[@Service]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Бизнес-логика: проверка данных, создание и изменение задач&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7D7F5;fontColor=#0f1b2d;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="330" width="320" height="120" as="geometry"/></mxCell><mxCell id="p3_tr" value="&lt;b&gt;TaskRepository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Spring Data JPA]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Доступ к таблице tasks, сущность Task&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7D7F5;fontColor=#0f1b2d;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="570" width="250" height="150" as="geometry"/></mxCell><mxCell id="p3_tk" value="&lt;b&gt;TaskCache&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Spring Cache / RedisTemplate]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Кэш списка задач, сброс при изменении&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7D7F5;fontColor=#0f1b2d;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="570" width="250" height="150" as="geometry"/></mxCell><mxCell id="p3_ns" value="&lt;b&gt;NotificationService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[@Service]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Формирует и отправляет напоминания о сроках&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7D7F5;fontColor=#0f1b2d;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="570" width="250" height="150" as="geometry"/></mxCell><mxCell id="p3_d" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[PostgreSQL 16]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Таблица tasks&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#2F6FA8;fontColor=#ffffff;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="860" width="250" height="130" as="geometry"/></mxCell><mxCell id="p3_r" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Кэш]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Кэш списка задач&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0562B;fontColor=#ffffff;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="860" width="250" height="130" as="geometry"/></mxCell><mxCell id="p3_m" value="&lt;b&gt;Email-сервис&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Внешняя система]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Отправка писем&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8a8a8a;fontColor=#ffffff;strokeColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="860" width="250" height="130" as="geometry"/></mxCell><mxCell id="ep30" value="HTTP-запрос" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_g" target="p3_tc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ep31" value="Вызывает" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_tc" target="p3_ts"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ep32" value="Читает и пишет задачи" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_ts" target="p3_tr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ep33" value="Берёт и сбрасывает кэш" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_ts" target="p3_tk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ep34" value="Запускает напоминания" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_ts" target="p3_ns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ep35" value="JDBC :5432" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_tr" target="p3_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ep36" value="RESP :6379" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent=